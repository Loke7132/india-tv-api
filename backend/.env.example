# Your authorized provider playlist. Keep credentials only in this file.
UPSTREAM_M3U_URL='https://provider.example/get.php?username=YOUR_USER&password=YOUR_PASSWORD&type=m3u_plus&output=ts'
# To merge multiple playlists, use this instead (it overrides UPSTREAM_M3U_URL):
# UPSTREAM_M3U_URLS_JSON='["https://example.com/one.m3u","https://example.com/two.m3u"]'
# Optional language codes corresponding to each URL above.
# UPSTREAM_M3U_LANGUAGES_JSON='["tam","tel"]'

# Generate with: python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_KEY

# Choose a long random value. Clients use /playlist.m3u?api_key=THIS_VALUE
PROXY_API_KEY=REPLACE_WITH_RANDOM_KEY

# Optional provider-required headers as a JSON object.
UPSTREAM_HEADERS_JSON='{"User-Agent":"IPTV-Proxy/1.0"}'

UPSTREAM_CONNECT_TIMEOUT_SECONDS=10
# Leave blank for live streams with no read timeout.
UPSTREAM_READ_TIMEOUT_SECONDS=
# 0 means encrypted stream links do not expire.
STREAM_TOKEN_TTL_SECONDS=0

# Optional newline-delimited upstream URL allowlist for ?verified=true playlists.
# VERIFIED_STREAM_URLS_FILE=verified_stream_urls.txt

# Optional and risky: narrowly scoped exceptions for upstream hosts with broken TLS.
# INSECURE_UPSTREAM_TLS_HOSTS_JSON='["legacy-stream.example"]'

# Optional public browser integration. This exposes /web/playlist.m3u only to this CORS origin.
# PUBLIC_WEB_ORIGIN=https://username.github.io
